<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        x:Class="EquipmentBorrowing.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="1000" Height="640"
        MinWidth="820" MinHeight="520">

	<Grid RowDefinitions="Auto,*">

		<Border Grid.Row="0" Classes="titleBar">
			<TextBlock Text="Campus Equipment Borrowing System" Classes="heading" />
		</Border>

		<Grid Grid.Row="1" ColumnDefinitions="200,*">
			<!-- Navigation sidebar -->
			<StackPanel Grid.Column="0" Classes="sidebar" Spacing="4">
				<Button Content="Equipment"
						Classes="navButton"
						Command="{Binding ShowEquipmentCommand}" />
				<Button Content="Active Borrowings"
						Classes="navButton"
						Command="{Binding ShowBorrowingsCommand}" />
				<Button Content="Search Borrowings"
						Classes="navButton"
						Command="{Binding ShowSearchCommand}" />
				<Button Content="Students"
						Classes="navButton"
						Command="{Binding ShowStudentsCommand}" />
				<Button Content="Manage Equipment"
						Classes="navButton"
						Command="{Binding ShowEquipmentManagementCommand}" />
			</StackPanel>

			<!-- Current view -->
			<Border Grid.Column="1" Classes="contentArea">
				<Grid>
					<TextBlock Text="Starting up: connecting to the database…"
							   Classes="infoText"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   IsVisible="{Binding IsStarting}" />
					<ContentControl Content="{Binding CurrentViewModel}"
									IsVisible="{Binding !IsStarting}" />
				</Grid>
			</Border>
		</Grid>

	</Grid>

</Window>
