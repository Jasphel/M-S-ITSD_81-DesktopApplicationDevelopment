<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="Active Borrowings" Classes="sectionHeading" />

    <StackPanel Grid.Row="1">
      <Border Classes="errorBanner" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Retry" Command="{Binding LoadCommand}" Margin="12,0,0,0" />
        </Grid>
      </Border>
      <TextBlock Text="Loading…" Classes="infoText" IsVisible="{Binding IsBusy}" />
      <TextBlock Text="There are no active borrowings." Classes="infoText" IsVisible="{Binding ShowEmptyState}" />
    </StackPanel>

    <ListBox Grid.Row="2"
             Margin="0,6,0,10"
             ItemsSource="{Binding ActiveBorrowings}"
             SelectedItem="{Binding SelectedBorrowing}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BorrowingListItem">
          <Border Classes="listRow">
            <Grid ColumnDefinitions="*,*,140,140">
              <TextBlock Grid.Column="0" Text="{Binding StudentName}" />
              <TextBlock Grid.Column="1" Text="{Binding EquipmentName}" />
              <TextBlock Grid.Column="2" Text="{Binding DateBorrowed, StringFormat='Borrowed {0:MMM d}'}" Classes="muted" />
              <TextBlock Grid.Column="3" Text="{Binding ExpectedReturnDate, StringFormat='Due {0:MMM d}'}" Classes="muted" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="3" Classes="panel">
      <StackPanel Spacing="10">
        <Button Content="Return Equipment"
                Classes="primaryButton"
                Command="{Binding ReturnCommand}"
                HorizontalAlignment="Left" />
        <TextBlock Text="{Binding StatusMessage}"
                   Classes="statusMessage"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
