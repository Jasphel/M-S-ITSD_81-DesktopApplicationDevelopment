<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
	  <!-- RowGap to RowbSpacing to eventually removing it and modifying the Listbox Grid -->

    <TextBlock Grid.Row="0" Text="Active Borrowings" Classes="sectionHeading" />

    <!-- added the margin after removing rowSpacing -->
    <ListBox Grid.Row="1"
             Margin="0,10,0,10"
             ItemsSource="{Binding ActiveBorrowings}"
             SelectedItem="{Binding SelectedBorrowing}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BorrowingListItem">
          <Border Classes="listRow">
            <Grid ColumnDefinitions="*,*,140,140">
              <TextBlock Grid.Column="0" Text="{Binding StudentName}" />
              <TextBlock Grid.Column="1" Text="{Binding EquipmentName}" />
              <TextBlock Grid.Column="2" Text="{Binding DateBorrowed, StringFormat='Borrowed {0:MMM d}'}" />
              <TextBlock Grid.Column="3" Text="{Binding ExpectedReturnDate, StringFormat='Due {0:MMM d}'}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="2" Classes="panel">
      <StackPanel Spacing="10">
        <Button Content="Return Equipment"
                Classes="primaryButton"
                Command="{Binding ReturnCommand}"
                HorizontalAlignment="Left" />
        <TextBlock Text="{Binding StatusMessage}"
                   Classes="statusMessage"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
