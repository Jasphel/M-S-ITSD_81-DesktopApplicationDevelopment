<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:views="using:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <!--
      This is the "navigation" mechanism: MainWindowViewModel just swaps
      which ViewModel instance is "current." Avalonia looks up the
      matching View here and renders it. Neither ViewModel nor Window
      code-behind has to know which View corresponds to which ViewModel.
    -->
    <DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
      <views:EquipmentView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BorrowingsViewModel}">
      <views:BorrowingsView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://EquipmentBorrowing.Desktop/Styles/AppStyles.axaml" />
  </Application.Styles>

</Application>
